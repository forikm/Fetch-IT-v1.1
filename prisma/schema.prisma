// MySQL-ready Prisma schema — same models as the SQLite dev schema but
// configured for MySQL (Aiven, PlanetScale, Railway, freedb.tech, etc.).
//
// To use on Vercel:
//   1. Provision a MySQL database (see DEPLOY-VERCEL.md for free options).
//   2. Set DATABASE_URL to the connection string (mysql://user:pass@host:port/dbname).
//   3. Overwrite prisma/schema.prisma with this file before running `prisma generate`.
//   4. Run `bunx prisma db push` to create the tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  passwordHash  String
  role          String    @default("CUSTOMER")
  vehicleClass  String?
  vehiclePlate  String?
  rating        Float     @default(5.0)
  totalDeliveries Int     @default(0)
  isOnline      Boolean   @default(false)
  lat           Float?
  lng           Float?
  locationAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookingsAsCustomer Booking[]       @relation("CustomerBookings")
  bookingsAsRider    Booking[]       @relation("RiderBookings")
  trackingUpdates    TrackingUpdate[]
  deliveryProofs     DeliveryProof[]
}

model Booking {
  id              String    @id @default(cuid())
  refCode         String    @unique
  customerId      String
  riderId         String?
  pickupLabel     String
  pickupLat       Float
  pickupLng       Float
  dropoffLabel    String
  dropoffLat      Float
  dropoffLng      Float
  vehicleClass    String
  cargoWeightKg   Float     @default(1.0)
  cargoNotes      String?   @db.Text
  scheduledAt     DateTime?
  distanceKm      Float
  baseFare        Float
  surgeMultiplier Float     @default(1.0)
  totalFare       Float
  currency        String   @default("USD")
  status          String   @default("PENDING")
  matchedAt       DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  etaMinutes      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer        User      @relation("CustomerBookings", fields: [customerId], references: [id])
  rider           User?     @relation("RiderBookings",  fields: [riderId],    references: [id])
  trackingUpdates TrackingUpdate[]
  deliveryProofs  DeliveryProof[]

  @@index([status])
  @@index([riderId])
  @@index([customerId])
}

model TrackingUpdate {
  id         String   @id @default(cuid())
  bookingId  String
  riderId    String
  lat        Float
  lng        Float
  speedKph   Float?
  heading    Float?
  etaMinutes Int?
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider      User     @relation(fields: [riderId],   references: [id])

  @@index([bookingId])
  @@index([createdAt])
}

model DeliveryProof {
  id            String   @id @default(cuid())
  bookingId     String
  riderId       String
  proofType     String
  signatureSvg  String?  @db.Text
  otpCode       String?
  otpVerified   Boolean  @default(false)
  photoUrl      String?  @db.Text
  recipientName String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rider         User     @relation(fields: [riderId],   references: [id])

  @@index([bookingId])
}
